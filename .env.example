# Copy this file to .env, fill it in, then run `pnpm bootstrap` (local dev) and
# `pnpm bootstrap:gha` (GitHub Actions secrets). Never commit .env.

# Cloudflare account and API token (Workers, D1, R2, zone/DNS access).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Existing R2 bucket reused for Terraform state, plus an R2 S3 API-token pair.
# The shorter value is the Access Key ID; the longer value is the Secret Access
# Key. They are not the Cloudflare API token above.
TF_STATE_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Full Workers.dev suffix, e.g. "your-subdomain.workers.dev".
WORKERS_DEV_SUBDOMAIN=

# Auth (iglympics-style JWT cookie). JWT_SECRET signs session cookies; generate
# with `openssl rand -hex 32`. Leave blank and `pnpm bootstrap:gha` generates
# one for you. ADMIN_NAMES is a comma-separated list.
JWT_SECRET=
ADMIN_NAMES=just

# The roster, and the ONLY copy of it: this repo is public, so no users.json is
# committed and `pnpm bootstrap:gha` has nothing to fall back to — it refuses
# without this.
#
# SINGLE quotes, one line. The bootstrap scripts `source` this file, so double
# quotes around a value full of double quotes cancel out and bash deletes every
# one of them — you get {name:alice} and a JSON parse error. Single quotes pass
# the value through untouched (so no apostrophes inside it), and a newline ends
# the assignment, so keep the whole array on this line:
# USERS_JSON='[{ "name": "alice", "password": "correct-horse-battery" }]'
#
# Locally you may instead drop the same array in a gitignored users.json; without
# either, `pnpm dev` seeds the four throwaway users from users.example.json.
USERS_JSON=

# Gemini, two keys and no fallback between them: GEMINI_API_KEY scores photos,
# GEMINI_API_KEY_PAID draws avatars and is the only one billed per picture.
# Leave either blank and `pnpm bootstrap:gha` skips that secret — the worker then
# treats every evaluation as a failed one, and/or answers "offline" to a draw,
# instead of crashing. Both blank is how local runs.
GEMINI_API_KEY=
GEMINI_API_KEY_PAID=

# NOTE: this project does NOT use Cloudflare Access, so the ACCESS_* and GOOGLE_*
# variables from the shared template are ignored here. You may leave them unset.
