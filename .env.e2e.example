# Copy to `.env.e2e`. Wrangler layers this OVER `.env`, and `scripts/check-e2e-env.mjs`
# refuses to start the e2e server until it does: a developer's own `.env` otherwise
# seeds the real roster (every login 401s) and hands the avatar machine a live billed
# key (the specs that assert "offline" instead buy pictures).
JWT_SECRET=e2e-throwaway-secret
ADMIN_NAMES=tester
GEMINI_API_KEY=
GEMINI_API_KEY_PAID=
USERS_JSON=[{"name":"tester","password":"test-password-123"},{"name":"rival","password":"rival-password-123"},{"name":"voter","password":"voter-password-123"},{"name":"judge","password":"judge-password-123"}]
