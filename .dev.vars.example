# Normally generated by `pnpm bootstrap` from the root .env. Copy manually only
# when you want local development without running the bootstrap script.
#
# JWT_SECRET signs the session cookie. Locally it also has a committed default
# in wrangler.jsonc; set it here to override. In production it is a Wrangler
# secret set by the deploy pipeline.
JWT_SECRET=local-dev-secret-not-for-production

# GEMINI_API_KEY is what the AI jury scores submissions with, and NOTHING else.
# Leave it out and every evaluation takes its failure path (score 5, ai_status
# "failed") — which is exactly how local and e2e are meant to run. In production
# it is a Wrangler secret set by the deploy pipeline.
GEMINI_API_KEY=

# GEMINI_API_KEY_PAID draws the trainer sprites, and is the ONLY key that is
# billed per picture — the avatar route never falls back to the one above.
# Without it the sprite machine answers "offline" without spending anyone's
# quota, which is again how local and e2e run.
GEMINI_API_KEY_PAID=
